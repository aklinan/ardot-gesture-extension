{
  "manifest_version": 3,
  "name": "Ardot 手势增强",
  "version": "1.0.0",
  "description": "把 Ardot 画布改成：滚轮缩放、右键拖拽平移。Ctrl+Alt+J 可随时开关。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ardot 手势增强",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://ardot.tencent.com/*",
        "https://*.ardot.tencent.com/*",
        "https://ardot.qq.com/*",
        "https://ardot.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
